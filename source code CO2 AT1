#include <WiFi.h>
#include <WebServer.h>
#include <DHT.h>

#define DHTPIN 4
#define DHTTYPE DHT11

#define MQ135_PIN 34
#define BUZZER_PIN 25
#define LED_PIN 26
#define RELAY_PIN 27

const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

DHT dht(DHTPIN, DHTTYPE);
WebServer server(80);

float temperature = 0;
float humidity = 0;
int airValue = 0;

String airStatus = "Unknown";
bool fanStatus = false;

const int MODERATE_LIMIT = 500;
const int POOR_LIMIT = 750;

void readSensors()
{
  airValue = analogRead(MQ135_PIN);

  temperature = dht.readTemperature();
  humidity = dht.readHumidity();

  if (isnan(temperature) || isnan(humidity))
  {
    Serial.println("DHT sensor error");
    return;
  }

  if (airValue < MODERATE_LIMIT)
  {
    airStatus = "GOOD";
    fanStatus = false;
  }
  else if (airValue < POOR_LIMIT)
  {
    airStatus = "MODERATE";
    fanStatus = false;
  }
  else
  {
    airStatus = "POOR";
    fanStatus = true;
  }

  digitalWrite(RELAY_PIN, fanStatus ? HIGH : LOW);

  if (airStatus == "POOR")
  {
    digitalWrite(BUZZER_PIN, HIGH);
    digitalWrite(LED_PIN, HIGH);
  }
  else
  {
    digitalWrite(BUZZER_PIN, LOW);
    digitalWrite(LED_PIN, LOW);
  }

  Serial.println("-------------------------");
  Serial.print("Air Value: ");
  Serial.println(airValue);

  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.println(" C");

  Serial.print("Humidity: ");
  Serial.print(humidity);
  Serial.println(" %");

  Serial.print("Air Status: ");
  Serial.println(airStatus);

  Serial.print("Fan: ");
  Serial.println(fanStatus ? "ON" : "OFF");
}

String createPage()
{
  String page = "";

  page += "<!DOCTYPE html>";
  page += "<html>";
  page += "<head>";

  page += "<meta name='viewport' ";
  page += "content='width=device-width, initial-scale=1'>";

  page += "<meta http-equiv='refresh' content='5'>";

  page += "<title>Smart Air Quality</title>";

  page += "<style>";

  page += "body{font-family:Arial;";
  page += "background:#f2f2f2;";
  page += "text-align:center;}";

  page += ".container{max-width:500px;";
  page += "margin:auto;}";

  page += ".card{background:white;";
  page += "padding:20px;";
  page += "margin:15px;";
  page += "border-radius:12px;";
  page += "box-shadow:0 2px 8px #aaa;}";

  page += ".value{font-size:28px;";
  page += "font-weight:bold;}";

  page += "</style>";

  page += "</head>";

  page += "<body>";

  page += "<div class='container'>";

  page += "<h1>Smart Home Air Quality</h1>";

  page += "<div class='card'>";
  page += "<h2>Air Quality</h2>";
  page += "<div class='value'>";
  page += airStatus;
  page += "</div>";
  page += "</div>";

  page += "<div class='card'>";
  page += "<h2>Gas Sensor</h2>";
  page += "<div class='value'>";
  page += String(airValue);
  page += "</div>";
  page += "</div>";

  page += "<div class='card'>";
  page += "<h2>Temperature</h2>";
  page += "<div class='value'>";
  page += String(temperature, 1);
  page += " &deg;C</div>";
  page += "</div>";

  page += "<div class='card'>";
  page += "<h2>Humidity</h2>";
  page += "<div class='value'>";
  page += String(humidity, 1);
  page += " %</div>";
  page += "</div>";

  page += "<div class='card'>";
  page += "<h2>Ventilation Fan</h2>";
  page += "<div class='value'>";
  page += fanStatus ? "ON" : "OFF";
  page += "</div>";
  page += "</div>";

  page += "</div>";

  page += "</body>";
  page += "</html>";

  return page;
}

void handleRoot()
{
  readSensors();
  server.send(200, "text/html", createPage());
}

void setup()
{
  Serial.begin(115200);

  pinMode(MQ135_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
  pinMode(RELAY_PIN, OUTPUT);

  digitalWrite(BUZZER_PIN, LOW);
  digitalWrite(LED_PIN, LOW);
  digitalWrite(RELAY_PIN, LOW);

  dht.begin();

  WiFi.begin(ssid, password);

  Serial.print("Connecting to Wi-Fi");

  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("Wi-Fi connected");

  Serial.print("ESP32 IP Address: ");
  Serial.println(WiFi.localIP());

  server.on("/", handleRoot);

  server.begin();

  Serial.println("Web server started");
}

void loop()
{
  server.handleClient();
}
